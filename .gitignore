# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage

# Per-developer Make overrides (e.g. PUIKIT_DIR for an editable PuiKit checkout)
Makefile.local

# PyPI long description — generated at build time by tools/gen_pypi_readme.py
# (make build): README.md with relative links rewritten to version-tagged URLs.
README.pypi.md

# Virtual environments
.venv/
venv/
ENV/
env/

# Local macOS signing config (non-secret, but per-machine; use signing.env.example)
macos_app/signing.env

# Local MSIX Store identity (non-secret, but per-account; use store.env.example)
windows_app/store.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# gh's telemetry device id, written here rather than under LOCALAPPDATA when
# gh runs with a stripped environment (some sandboxed shells drop it). Stray,
# but it has to be ignored: release_preflight refuses to tag on any untracked
# file, so this would block a release rather than merely add noise.
.local/

# OS
.DS_Store
Thumbs.db

# XeFM specific
*.tmp
*.log

# Windows app bundle build artifacts
windows_app/build/
windows_app/.cache/
# Generated MSIX Store tiles (produced by make_store_assets.py from XeFM.icns)
windows_app/resources/Assets/

temp/

# Test artifacts (but keep test fixtures)
test/demo_*_test_*/
# Note: test/test_edit.txt and test/test_syntax.json are test fixtures and should be tracked

/profiling_output

# The shared library the desktop builds bundle (windows_app/build.ps1 Step 4b
# downloads it into the *copied* package; this covers a developer dropping one
# into the working tree to test the bundled-lookup path).
xefm/_bin/
