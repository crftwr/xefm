    "version": "0.2.0",
    "configurations": [
        {
            "name": "XeFM-Terminal",
            "type": "debugpy",
            "request": "launch",
            "module": "xefm",
            "args": ["--backend", "curses"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "XeFM-Desktop",
            "type": "debugpy",
            "request": "launch",
            "module": "xefm",
            "args": ["--backend", "coregraphics"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
